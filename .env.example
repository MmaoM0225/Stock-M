# ============================================
# Stock-M 项目环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# --------------------------------------------
# LLM API 配置（必需）
# --------------------------------------------
# SiliconFlow（默认使用）
SILICONFLOW_API_KEY=your_siliconflow_api_key

# 其他可选 LLM 提供商
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key
# ZHIPU_API_KEY=your_zhipu_api_key

# --------------------------------------------
# 金融数据 API 配置
# --------------------------------------------
# Tushare Pro（A股数据）
TUSHARE_TOKEN=your_tushare_token

# Finlight API（全球金融新闻）
FINLIGHT_API_KEY=your_news_api_key
FINLIGHT_BASE_URL=https://api.finlight.com/v1

# Alpha Vantage（美股数据，可选）
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# 其他新闻 API（可选）
NEWS_API_KEY=your_news_api_key

# --------------------------------------------
# 数据库配置（可选，默认使用 SQLite）
# --------------------------------------------
# DATABASE_URL=sqlite:///data/database/stock_m.db
# 或使用 PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/stock_m

# --------------------------------------------
# 日志与调试配置
# --------------------------------------------
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG

# LLM 超时时间（秒）
# LLM_TIMEOUT=150

# --------------------------------------------
# 代理配置（如果需要）
# --------------------------------------------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
